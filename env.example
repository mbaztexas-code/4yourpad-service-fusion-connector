# DO NOT commit your real credentials
SERVICE_FUSION_CLIENT_ID=replace_me
SERVICE_FUSION_CLIENT_SECRET=replace_me

# Generate a long random string for this.
# Anyone calling protected connector endpoints must send:
# X-Connector-Key: <this value>
CONNECTOR_API_KEY=replace_with_long_random_value

SERVICE_FUSION_BASE=https://api.servicefusion.com/v1
SERVICE_FUSION_TOKEN_URL=https://api.servicefusion.com/oauth/access_token
